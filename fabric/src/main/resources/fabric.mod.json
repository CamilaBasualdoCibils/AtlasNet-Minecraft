{
  "schemaVersion": 1,
  "id": "atlasnet_minecraft",
  "version": "${version}",
  "name": "AtlasNet Minecraft Demo",
  "description": "Experimental Minecraft integration demo for AtlasNet.",
  "environment": "*",
  "mixins": ["atlasnet_minecraft.mixins.json"],
  "entrypoints": {
    "main": ["net.atlasnet.minecraft.fabric.FabricDemo"],
    "server": ["net.atlasnet.minecraft.fabric.FabricDedicatedServer"],
    "client": ["net.atlasnet.minecraft.fabric.FabricClient"]
  },
  "depends": {
    "fabricloader": ">=${loader_version}",
    "minecraft": "${minecraft_version}",
    "java": ">=21"
  }
}
