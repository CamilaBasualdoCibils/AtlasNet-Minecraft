{
  "schemaVersion": 1,
  "id": "atlasnet",
  "version": "${version}",
  "name": "AtlasNet Minecraft Demo",
  "description": "Experimental Minecraft integration demo for AtlasNet.",
  "environment": "*",
  "entrypoints": {
    "main": ["net.atlasnet.minecraft.fabric.AtlasNetFabric"],
    "server": ["net.atlasnet.minecraft.fabric.AtlasNetFabricServer"],
    "client": ["net.atlasnet.minecraft.fabric.client.AtlasNetFabricClient"]
  },
  "depends": {
    "fabricloader": ">=${loader_version}",
    "minecraft": "${minecraft_version}",
    "java": ">=21",
    "fabric-api": ">=${fabric_api_version}"
  }
}
