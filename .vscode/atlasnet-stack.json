{
  "program": "${workspaceFolder}/build/AtlasNet/AtlasNetNode",
  "cwd": "${workspaceFolder}/build",
  "preLaunchCommand": "\"${workspaceFolder}/scripts/minecraft-build.sh\" stack",
  "gdb": "${workspaceFolder}/scripts/minecraft-gdb.sh",
  "clusterPort": 42000,
  "handshakePort": 43000,
  "controlPanelPort": 8080,
  "ignoreShutdownSignals": true,
  "valgrind": false,
  "valgrindProgram": "/usr/bin/valgrind",
  "perf": false,
  "perfProgram": "/usr/bin/perf",
  "perfOutput": "${workspaceFolder}/build/perf-${index}.data",
  "valkeyURI": "tcp://127.0.0.1:46379",
  "launchValkey": true,
  "valkeyProgram": "${workspaceFolder}/build/_deps/valkey-src/src/valkey-server",
  "initializeCluster": true,
  "clusterMode": "direct",
  "clusterConfigPath": "",
  "clusterSettings": {
    "controller": {
      "heuristic": "example.xsplit2d",
      "shards": {
        "desired_count": 2
      }
    },
    "region_transfer": {
      "mode": "immediate",
      "hysteresis_distance": 0
    },
    "spatialPlane": "XZ",
    "application": {
      "minecraft": {
        "terrain-enabled": true,
        "server-properties": {
          "motd": "AtlasNet Minecraft",
          "level-name": "entity-acceptance-normal",
          "level-type": "minecraft:normal",
          "level-seed": "atlasnet-entity-acceptance",
          "online-mode": true,
          "view-distance": 10,
          "simulation-distance": 10,
          "difficulty": "normal",
          "gamemode": "survival",
          "max-players": 100,
          "pvp": true,
          "spawn-protection": 0
        }
      }
    }
  },
  "groups": [
    {
      "name": "Minecraft 25565",
      "count": 1,
      "capabilities": [
        "Database",
        "Shard",
        "ControllerEligible",
        "ClientIngress",
        "ControlPanel"
      ],
      "args": [],
      "nodeMode": "direct",
      "nodeConfigPath": "",
      "nodeSettings": {
        "shards": {
          "max_count": 1,
          "cpu_request": 2,
          "memory_request": "512MiB",
          "worker_executable": ""
        },
        "modules": [
          "${workspaceFolder}/build/AtlasNet/Examples/Heuristics/XAxisSplit/AtlasNetXAxisSplit.so",
          "${workspaceFolder}/build/host/libatlasnet-minecraft-shard.so",
          "${workspaceFolder}/build/host/libatlasnet-minecraft-endpoint.so",
          "${workspaceFolder}/build/host/libatlasnet-minecraft-admission.so",
          "${workspaceFolder}/build/host/libatlasnet-minecraft-spawn.so"
        ],
        "control_panel": {
          "address": "127.0.0.1",
          "port": 8080
        },
        "ingress-listeners": [],
        "ingress-endpoints": [
          {
            "id": "minecraft-1",
            "name": "minecraft",
            "args": {
              "port": 25565
            }
          }
        ]
      }
    },
    {
      "name": "Minecraft 25566",
      "count": 1,
      "capabilities": [
        "Shard",
        "ClientIngress"
      ],
      "args": [],
      "nodeMode": "direct",
      "nodeConfigPath": "",
      "nodeSettings": {
        "shards": {
          "max_count": 1,
          "cpu_request": 2,
          "memory_request": "512MiB",
          "worker_executable": ""
        },
        "modules": [
          "${workspaceFolder}/build/AtlasNet/Examples/Heuristics/XAxisSplit/AtlasNetXAxisSplit.so",
          "${workspaceFolder}/build/host/libatlasnet-minecraft-shard.so",
          "${workspaceFolder}/build/host/libatlasnet-minecraft-endpoint.so",
          "${workspaceFolder}/build/host/libatlasnet-minecraft-admission.so",
          "${workspaceFolder}/build/host/libatlasnet-minecraft-spawn.so"
        ],
        "ingress-listeners": [],
        "ingress-endpoints": [
          {
            "id": "minecraft-2",
            "name": "minecraft",
            "args": {
              "port": 25566
            }
          }
        ]
      }
    }
  ]
}
