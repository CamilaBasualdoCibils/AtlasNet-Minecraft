{
  "program": "${workspaceFolder}/build/AtlasNet/AtlasNetNode",
  "cwd": "${workspaceFolder}/build",
  "preLaunchCommand": "cmake --preset minecraft -S \"${workspaceFolder}\" && cmake --build \"${workspaceFolder}/build\" --target BuildServer --parallel 2 && env MINECRAFT_TERRAIN_PRESET=normal python3 \"${workspaceFolder}/scripts/minecraft-valkey.py\" start --stack-session",
  "gdb": "${workspaceFolder}/scripts/minecraft-stack-gdb",
  "clusterPort": 42000,
  "handshakePort": 43000,
  "controlPanelPort": 8080,
  "ignoreShutdownSignals": true,
  "valgrind": false,
  "valgrindProgram": "/usr/bin/valgrind",
  "perf": false,
  "perfProgram": "/usr/bin/perf",
  "perfOutput": "${workspaceFolder}/build/perf-${index}.data",
  "valkeyURI": "tcp://127.0.0.1:46380",
  "launchValkey": true,
  "valkeyProgram": "${workspaceFolder}/build/_deps/valkey-src/src/valkey-server",
  "initializeCluster": true,
  "clusterMode": "direct",
  "clusterConfigPath": "",
  "clusterSettings": {
    "spatialPlane": "XZ",
    "controller": {
      "heuristic": "atlasnet.kmeans2d",
      "autoscale": {
        "enabled": false
      },
      "spatial": {
        "recompute_interval": "60000ms"
      },
      "shards": {
        "desired_count": 2
      },
      "dimension": 2
    },
    "region_transfer": {
      "hysteresis_distance": 0,
      "mode": "batched",
      "batch_interval": "50ms"
    }
  },
  "groups": [
    {
      "name": "Minecraft ingress A",
      "count": 1,
      "capabilities": [
        "Database",
        "Shard",
        "ControllerEligible",
        "ClientIngress",
        "ControlPanel"
      ],
      "args": [],
      "nodeMode": "direct",
      "nodeConfigPath": "",
      "nodeSettings": {
        "shards": {
          "max_count": 1,
          "worker_executable": "${workspaceFolder}/build/AtlasNet/AtlasNetShardWorker"
        },
        "modules": [
          "${workspaceFolder}/build/native/AtlasNetMinecraftShard.so",
          "${workspaceFolder}/build/AtlasNet/AtlasNetSteamNetSock.so",
          "${workspaceFolder}/build/AtlasNet/Examples/Heuristics/XAxisSplit/AtlasNetXAxisSplit.so"
        ],
        "control_panel": {
          "address": "127.0.0.1",
          "port": 8080
        },
        "ingress": [
          {
            "transport": "SteamNetSock",
            "port": 5919,
            "admission": "AllowAll",
            "spawn": "Static(minecraft:overworld,-12:-60:0)"
          }
        ]
      }
    },
    {
      "name": "Minecraft ingress B",
      "count": 1,
      "capabilities": [
        "Database",
        "Shard",
        "ControllerEligible",
        "ClientIngress"
      ],
      "args": [],
      "nodeMode": "direct",
      "nodeConfigPath": "",
      "nodeSettings": {
        "shards": {
          "max_count": 1,
          "worker_executable": "${workspaceFolder}/build/AtlasNet/AtlasNetShardWorker"
        },
        "modules": [
          "${workspaceFolder}/build/native/AtlasNetMinecraftShard.so",
          "${workspaceFolder}/build/AtlasNet/AtlasNetSteamNetSock.so",
          "${workspaceFolder}/build/AtlasNet/Examples/Heuristics/XAxisSplit/AtlasNetXAxisSplit.so"
        ],
        "ingress": [
          {
            "transport": "SteamNetSock",
            "port": 5920,
            "admission": "AllowAll",
            "spawn": "Static(minecraft:overworld,12:-60:6)"
          }
        ]
      }
    }
  ]
}
